# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
TODO.md

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Exception: npm wrapper ships a placeholder bin/extend.exe stub that
# postinstall replaces with the real native binary.
!npm/cli/bin/extend.exe

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# mise local override (may contain secrets)
mise.local.toml

# Skill-evals workspace lives next to the repo (sibling) but if a user
# overrides --workspace to a path inside the repo, ignore it. Per-run
# artifacts (events.jsonl, extend-calls.jsonl, etc.) are not source.
extend-cli-evals-workspace/
evals/workspace/

# Editor/IDE
# .idea/
# .vscode/
